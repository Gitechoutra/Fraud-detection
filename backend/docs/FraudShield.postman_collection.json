{
  "info": {
    "name": "FraudShield API",
    "description": "SQL-Based Real-Time Fraud Detection and Transaction Monitoring System.\n\n1. Set `username` / `password` (a staff user from backend/.env) and, if changed, `apiKey` (INGEST_API_KEY).\n2. Run the collection top to bottom (Collection Runner, or `newman run`). Login stores the JWT; Customers stores an account number used by the payment requests; the ingested payment's alert and case ids are passed on to the next folders.\n\nNote: running it writes test data (a payment, an alert, a closed case, a watchlist entry that is removed again). See backend/docs/API.md for every field.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:5000/api"
    },
    {
      "key": "apiKey",
      "value": "dev-ingest-key"
    },
    {
      "key": "username",
      "value": "admin"
    },
    {
      "key": "password",
      "value": ""
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "refreshToken",
      "value": ""
    },
    {
      "key": "customerId",
      "value": ""
    },
    {
      "key": "accountNo",
      "value": ""
    },
    {
      "key": "extRef",
      "value": ""
    },
    {
      "key": "txnId",
      "value": ""
    },
    {
      "key": "alertId",
      "value": ""
    },
    {
      "key": "caseId",
      "value": ""
    },
    {
      "key": "ruleCode",
      "value": "R1"
    },
    {
      "key": "watchlistId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://127.0.0.1:5000/health",
              "protocol": "http",
              "host": [
                "127",
                "0",
                "0",
                "1"
              ],
              "port": "5000",
              "path": [
                "health"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 2xx\", () => pm.expect(pm.response.code).to.be.within(200, 299));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login (saves tokens)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 2xx\", () => pm.expect(pm.response.code).to.be.within(200, 299));",
                  "const d = pm.response.json().data;",
                  "pm.collectionVariables.set('accessToken', d.access_token);",
                  "pm.collectionVariables.set('refreshToken', d.refresh_token);",
                  "pm.test('got a JWT', () => pm.expect(d.access_token).to.be.a('string'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "me"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 2xx\", () => pm.expect(pm.response.code).to.be.within(200, 299));"
                ]
              }
            }
          ]
        },
        {
          "name": "Refresh access token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{refreshToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/refresh",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "refresh"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 2xx\", () => pm.expect(pm.response.code).to.be.within(200, 299));",
                  "pm.collectionVariables.set('accessToken', pm.response.json().data.access_token);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Customers",
      "item": [
        {
          "name": "List customers (saves customerId)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/customers?search=",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "customers"
              ],
              "query": [
                {
                  "key": "search",
                  "value": ""
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 2xx\", () => pm.expect(pm.response.code).to.be.within(200, 299));",
                  "const d = pm.response.json().data; const items = d.items || d;",
                  "if (items.length) pm.collectionVariables.set('customerId', items[0].id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Get customer (saves accountNo)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/customers/{{customerId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "customers",
                "{{customerId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 2xx\", () => pm.expect(pm.response.code).to.be.within(200, 299));",
                  "const a = pm.response.json().data.accounts;",
                  "if (a && a.length) pm.collectionVariables.set('accountNo', a[0].account_no);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Transactions",
      "item": [
        {
          "name": "Ingest one payment (API key)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{apiKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/transactions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "transactions"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"external_ref\": \"{{extRef}}\",\n  \"account_no\": \"{{accountNo}}\",\n  \"amount\": 95000,\n  \"channel\": \"UPI\",\n  \"city\": \"Delhi\",\n  \"device_id\": \"POSTMAN-NEW-PHONE\",\n  \"ip_address\": \"103.21.4.9\",\n  \"model_score\": 60\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            },
            "description": "Saved, checked by sp_evaluate_transaction and committed in one database transaction. A new device + large amount, so R4 (and usually R1) fire and an alert is raised."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('extRef', 'POSTMAN-' + Date.now());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 2xx\", () => pm.expect(pm.response.code).to.be.within(200, 299));",
                  "const d = pm.response.json().data;",
                  "pm.collectionVariables.set('txnId', d.txn_id);",
                  "if (d.alert_id) pm.collectionVariables.set('alertId', d.alert_id);",
                  "pm.test('decision with its rule evidence', () => {",
                  "  pm.expect(['APPROVED', 'REVIEW', 'BLOCKED']).to.include(d.status);",
                  "  if (d.status !== 'APPROVED') pm.expect(d.rules.length).to.be.above(0);",
                  "});",
                  "pm.test('latency to committed decision under 500 ms', () => pm.expect(d.total_ms).to.be.below(500));"
                ]
              }
            }
          ]
        },
        {
          "name": "Re-submit the same payment (idempotent)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{apiKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/transactions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "transactions"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"external_ref\": \"{{extRef}}\",\n  \"account_no\": \"{{accountNo}}\",\n  \"amount\": 95000,\n  \"channel\": \"UPI\",\n  \"city\": \"Delhi\",\n  \"device_id\": \"POSTMAN-NEW-PHONE\",\n  \"ip_address\": \"103.21.4.9\",\n  \"model_score\": 60\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 2xx\", () => pm.expect(pm.response.code).to.be.within(200, 299));",
                  "const d = pm.response.json().data;",
                  "pm.test('returns the stored decision, no second payment', () => {",
                  "  pm.expect(d.duplicate).to.eql(true);",
                  "  pm.expect(d.txn_id).to.eql(Number(pm.collectionVariables.get('txnId')));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Invalid payment is rejected (422)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{apiKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/transactions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "transactions"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"external_ref\": \"BAD-1\",\n  \"account_no\": \"{{accountNo}}\",\n  \"amount\": -5,\n  \"channel\": \"PIGEON\",\n  \"model_score\": 150\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('422 with field errors', () => pm.response.to.have.status(422));"
                ]
              }
            }
          ]
        },
        {
          "name": "Bulk CSV upload",
          "request": {
            "method": "POST",
            "header": [
              {
