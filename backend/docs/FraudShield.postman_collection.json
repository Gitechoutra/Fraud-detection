        },
        {
          "name": "Update rule (weight / params / on-off)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/rules/{{ruleCode}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "rules",
                "{{ruleCode}}"
              ]
