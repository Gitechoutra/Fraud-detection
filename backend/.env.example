ANALYST_PASSWORD=Analyst@123
RISK_USERNAME=risk
RISK_PASSWORD=Risk@123
# console | msg91 | twilio
NOTIFIER=console
MSG91_AUTH_KEY=
MSG91_SENDER=FRSHLD
